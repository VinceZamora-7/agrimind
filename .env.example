PORT=5000
CAMERA_DEVICE=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._REDRAGON_Live_Camera_SN0001-video-index0
CAMERA_AUTO_DISCOVERY=true
CAMERA_DISCOVERY_RETRY_SECONDS=10
CAMERA_RESOLUTION=640x480
CAMERA_WARMUP_FRAMES=30
CAMERA_CAPTURE_SKIP_FRAMES=5
CAMERA_EXPOSURE_RETUNE_SECONDS=300
CAMERA_LOW_LIGHT_THRESHOLD=45
CAMERA_LOW_LIGHT_EXPOSURE=5000
CAMERA_LOW_LIGHT_GAIN=100
CAPTURE_BURST_COUNT=1
CAPTURE_BURST_INTERVAL_MS=350
CAPTURE_MINIMUM_BYTES=5000
GPIO_CHIP=gpiochip0
GPIO_LINE=6
PIR_POLL_MS=500
PIR_DEBOUNCE_READINGS=2
PIR_REARM_LOW_SECONDS=2
DETECTION_COOLDOWN_SECONDS=5
EVENT_GROUPING_SECONDS=5
DUPLICATE_DETECTION_ENABLED=false
DUPLICATE_HASH_DISTANCE=5
DUPLICATE_WINDOW_SECONDS=300
CAPTURE_RETENTION_HOURS=2
CAPTURE_CLEANUP_INTERVAL_MINUTES=10

# capture_only | manual_analysis | automatic_analysis
ANALYSIS_MODE=automatic_analysis
AGRIMIND_API_TOKEN=

# Shared secret used by both ESP8266 slaves when posting sensor readings.
# Generate a long random value before enabling pairing enforcement.
ESP8266_API_TOKEN=

# Local SHT41 provides current farm conditions; Open-Meteo remains the forecast source.
SHT41_ENABLED=true
SHT41_I2C_BUS=0
SHT41_I2C_ADDRESS=68
SHT41_SAMPLE_SECONDS=5
SHT41_STALE_SECONDS=180
SHT41_AVERAGING_SAMPLES=5
I2C_TRANSFER_PATH=/usr/sbin/i2ctransfer

# Fixed farm coordinates used for weather; do not use the phone's temporary location.
FARM_LATITUDE=
FARM_LONGITUDE=
FARM_LOCATION_NAME=Agrimind Farm
WEATHER_REFRESH_MINUTES=10
WEATHER_TIMEOUT_SECONDS=12

# Official DOST-PAGASA Atom/CAP hazard feed.
# Test-only laptop weather simulator. Keep disabled outside testing.
WEATHER_SIMULATOR_ENABLED=false
WEATHER_SIMULATOR_URL=http://192.168.18.2:5055
WEATHER_SIMULATOR_POLL_SECONDS=3
WEATHER_SIMULATOR_TIMEOUT_SECONDS=5

PAGASA_ALERTS_ENABLED=true
PAGASA_ALERT_FEED_URL=https://publicalert.pagasa.dost.gov.ph/feeds/
PAGASA_ALERT_REFRESH_MINUTES=5
PAGASA_ALERT_TIMEOUT_SECONDS=20
PAGASA_ALERT_MAX_ENTRIES=50

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MIN_INTERVAL_SECONDS=5
GEMINI_MAX_REQUESTS_PER_HOUR=30
GEMINI_MAX_REQUESTS_PER_DAY=100
GEMINI_MAX_FAILURE_RETRIES=1
GEMINI_DAILY_BUDGET_USD=0.25
GEMINI_ESTIMATED_COST_PER_REQUEST_USD=0.002
GEMINI_TIMEOUT_SECONDS=30

SMS_ALERTS_ENABLED=false
SEMAPHORE_API_KEY=
# Leave blank to use the account default, or enter an Active Semaphore sender name.
SEMAPHORE_SENDER_NAME=
ALERT_RECIPIENTS=09171234567,09981234567
SEMAPHORE_MAX_MESSAGES_PER_DAY=20
SEMAPHORE_TIMEOUT_SECONDS=15
SMS_COOLDOWN_SECONDS=300
SECURITY_SMS_COOLDOWN_SECONDS=300
PLANT_SMS_COOLDOWN_SECONDS=60
WEATHER_SMS_COOLDOWN_SECONDS=7200
SENSOR_OFFLINE_SMS_COOLDOWN_SECONDS=1800
DAILY_WEATHER_SMS_ENABLED=true
DAILY_WEATHER_SMS_TIME=06:00
HEAT_INDEX_ALERT_ENABLED=true
HEAT_INDEX_ALERT_THRESHOLD_C=42
RAIN_ALERT_ENABLED=true
RAIN_ALERT_PROBABILITY_PERCENT=80
RAIN_ALERT_MM=20
TYPHOON_ALERT_ENABLED=true
PLANT_ABNORMAL_ALERT_ENABLED=true
SENSOR_OFFLINE_MINUTES=30
SMS_PROJECT_CREDIT_LIMIT=50
SMS_LOW_BALANCE_CREDITS=20

# Optional VPS synchronization. Disabled until the hosted cloud API exists.
CLOUD_SYNC_ENABLED=false
CLOUD_API_BASE_URL=https://api.example.com
CLOUD_DEVICE_ID=agrimind-farm-001
CLOUD_DEVICE_TOKEN=
CLOUD_SYNC_TIMEOUT_SECONDS=15

# Local mobile pairing. Enable enforcement after the first administrator phone pairs.
PAIRING_ENABLED=true
PAIRING_ENFORCE_AUTH=false
PAIRING_ALLOW_ALWAYS=true
PAIRING_DEVICE_ID=agrimind-farm-001
PAIRING_DEVICE_NAME=Agrimind Farm
PAIRING_LOCAL_URLS=http://orangepione.local:5000,http://192.168.18.5:5000
